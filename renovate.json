{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rebaseWhen": "behind-base-branch",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Group patch and minor updates together",
      "matchUpdateTypes": ["minor", "patch"],
      "excludePackageNames": ["vite-plus"],
      "groupName": "dependencies (minor and patch)",
      "groupSlug": "dependencies-minor-patch"
    },
    {
      "description": "vite-plus is the core toolchain; require manual review",
      "matchPackageNames": ["vite-plus"],
      "automerge": false,
      "groupName": null
    }
  ]
}
